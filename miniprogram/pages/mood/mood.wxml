<view class="page-root">
  <!-- 顶部导航胶囊（内联，不用组件——组件编译在本环境不稳定） -->
  <view class="nb-capsule" style="padding-top:{{statusBarHeight}}px;">
    <view class="nb-pill">
      <!-- WebGL 流动烟雾背景 -->
      <canvas type="webgl" id="nb-flux" class="nb-flux"></canvas>
      <view class="nb-title">心情</view>
    </view>
  </view>

  <view class="bg-decor"></view>
  <!-- 顶部大标题 -->
  <view class="appbar">
    <view class="greet">今天的心情</view>
    <view class="headline"><view class="hl"></view><text>怎么样？</text></view>
    <view class="sub">点一下记下</view>
  </view>

  <!-- 情绪网格 3×2 -->
  <view class="sec-title">记一笔</view>
  <view class="mood-grid">
    <view
      wx:for="{{moods}}"
      wx:key="label"
      class="mood"
      hover-class="mood-pressed"
      hover-stay-time="80"
      data-emoji="{{item.emoji}}"
      data-label="{{item.label}}"
      bindtap="tapMood"
    >
      <view class="mo">{{item.emoji}}</view>
      <view class="ml">{{item.label}}</view>
    </view>
  </view>

  <!-- 时间线记录 -->
  <block wx:if="{{list.length}}">
    <view class="sec-title">最近记录</view>
    <view wx:for="{{list}}" wx:key="index" class="mood-item">
      <view class="mo">{{item.emoji}}</view>
      <view class="mi-info">
        <view class="mi-label">{{item.label}}</view>
        <view class="mi-time">{{item.time}}</view>
      </view>
      <view class="day-tag">{{item.dayTag}}</view>
    </view>

    <!-- 本周小结卡片 -->
    <view wx:if="{{summary}}" class="summary-card">
      <view class="sum-t">本周心情小结 💗</view>
      <view class="sum-d">这周你记了 <text class="sum-b">{{summary.count}}</text> 次，<text class="sum-b">{{summary.top}}</text> 出现最多。<text wx:if="{{summary.missNights}}">有 <text class="sum-b">{{summary.missNights}}</text> 个晚上是「想你」收尾的。</text></view>
    </view>
  </block>

  <!-- 空状态 -->
  <view wx:else class="empty">
    <view class="e">💛</view>
    <view class="t">还没记录过</view>
    <view>点一下上面的心情，记下此刻</view>
  </view>

  <!-- 大粒子动画（不规则飘散） -->
  <view class="particles-layer" wx:if="{{particles.length}}">
    <view
      wx:for="{{particles}}"
      wx:key="id"
      class="particle-anim"
      style="left:{{item.left}}rpx;top:{{item.top}}rpx;font-size:{{item.size}}rpx;--dx:{{item.dx}}rpx;--dy:{{item.dy}}rpx;--rot:{{item.rot}}deg;--dur:{{item.dur}}s;"
    >{{item.emoji}}</view>
  </view>

  <view class="footer-space"></view>
</view>
