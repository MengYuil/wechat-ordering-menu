<view class="page-root">
  <!-- 顶部导航胶囊（内联，不用组件——组件编译在本环境不稳定） -->
  <view class="nb-capsule" style="padding-top:{{statusBarHeight}}px;">
    <view class="nb-pill">
      <!-- WebGL 流动烟雾背景 -->
      <canvas type="webgl" id="nb-flux" class="nb-flux"></canvas>
      <view wx:if="{{showBack}}" class="nb-back" bindtap="goBack">‹</view>
      <view class="nb-title">订单</view>
    </view>
  </view>

  <view class="bg-decor"></view>
  <!-- 副标题 -->
  <view class="page-sub">{{subText}}</view>

  <!-- 今晚这单（未提交的购物车） -->
  <view wx:if="{{cartList.length}}" class="card current-card">
    <view class="sec-title">今晚这单</view>

    <view wx:for="{{cartList}}" wx:key="dishId" class="oi-item">
      <view class="oi-emoji">{{item.emoji}}</view>
      <view class="oi-info">
        <view class="oi-name">{{item.name}}</view>
        <view class="oi-price">¥{{item.price}}</view>
      </view>
      <view class="stepper">
        <view class="step-btn" data-id="{{item.dishId}}" bindtap="decCount">−</view>
        <view class="step-num">{{item.count}}</view>
        <view class="step-btn add" data-id="{{item.dishId}}" bindtap="incCount">＋</view>
      </view>
    </view>

    <view class="divider"></view>
    <view class="line">
      <text>合计</text>
      <text class="line-price big">¥{{cartTotal}}</text>
    </view>

    <textarea
      class="remark"
      placeholder="附言：少放辣、多加点香菜…"
      placeholder-class="remark-ph"
      maxlength="60"
      value="{{remark}}"
      bindinput="onRemark"
    ></textarea>

    <view class="btn-main submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submitOrder">去下单</view>
  </view>

  <!-- 历史订单 -->
  <block wx:if="{{orders.length}}">
    <view class="sec-title hist-title">历史订单</view>
    <view wx:for="{{orders}}" wx:key="_id" class="card order-card">
      <view class="order-head">
        <view class="order-no">单号 {{item.orderNo}}</view>
        <view class="tag" style="color:{{item.statusColor}};background:{{item.statusBg}}">{{item.statusText}}</view>
      </view>
      <view class="order-items">{{item.summary}}</view>
      <view class="order-remark" wx:if="{{item.remark}}">💬 {{item.remark}}</view>
      <view class="order-foot">
        <view class="order-time">{{item.timeText}}</view>
        <view class="order-total">¥{{item.total}}</view>
      </view>
      <view class="order-actions" wx:if="{{item.actions.length}}">
        <view
          wx:for="{{item.actions}}"
          wx:for-item="act"
          wx:key="value"
          class="action-btn {{act.value === 'cancel' ? 'ghost' : ''}}"
          data-id="{{item._id}}"
          data-action="{{act.value}}"
          bindtap="onAction"
        >{{act.label}}</view>
      </view>
    </view>
  </block>

  <!-- 空状态 -->
  <view wx:if="{{!loading && !cartList.length && !orders.length}}" class="empty">
    <view class="e">📭</view>
    <view class="t">还没下过单</view>
    <view>去菜单点几道吧</view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <view class="footer-space"></view>
</view>
