/* ===== 陪伴页 —— Liquid Glass ===== */

/* 想你了 圆形按钮（蓝色渐变） */
.miss-circle {
  width: 320rpx;
  height: 320rpx;
  margin: 40rpx auto 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4DA3FF 0%, #007AFF 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 24rpx 56rpx rgba(0, 122, 255, 0.30);
  transition: transform 150ms var(--ease-out);
}

.miss-hover,
.miss-circle.pressed {
  transform: scale(0.94);
}

.mc-emoji {
  font-size: 112rpx;
  line-height: 1;
}

.mc-label {
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 16rpx;
  color: #fff;
}

/* 早安 / 晚安 */
.companion-row {
  display: flex;
  gap: 20rpx;
  margin: 0 32rpx 24rpx;
}

.c-half {
  flex: 1;
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: saturate(200%) blur(16rpx);
  -webkit-backdrop-filter: saturate(200%) blur(16rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.8),
    inset 0 1rpx 3rpx rgba(255, 255, 255, 0.7),
    0 8rpx 24rpx rgba(0, 0, 0, 0.06),
    0 0 20rpx rgba(10, 132, 255, 0.18);
  border-radius: 999rpx;
  padding: 36rpx 0;
  text-align: center;
  transition: transform 140ms var(--ease-out);
}

.c-half-pressed {
  transform: scale(0.95);
}

.ch-emoji {
  font-size: 64rpx;
  line-height: 1;
}

.ch-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

/* 飘心动画层 */
.hearts-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 300;
  overflow: hidden;
}

.heart-anim {
  position: absolute;
  opacity: 0;
  animation: heart-float var(--dur) cubic-bezier(0.2, 0.6, 0.3, 1) forwards;
}

@keyframes heart-float {
  0% {
    transform: translate(0, 0) rotate(0deg) scale(0.4);
    opacity: 0.95;
  }
  100% {
    transform: translate(var(--dx), var(--dy)) rotate(var(--rot)) scale(1.1);
    opacity: 0;
  }
}

/* 互动记录列表 */
.cp-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: saturate(200%) blur(16rpx);
  -webkit-backdrop-filter: saturate(200%) blur(16rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.8),
    inset 0 1rpx 3rpx rgba(255, 255, 255, 0.7),
    0 8rpx 24rpx rgba(0, 0, 0, 0.06),
    0 0 20rpx rgba(10, 132, 255, 0.16);
  border-radius: 999rpx;
  padding: 26rpx 32rpx;
  margin: 0 32rpx 20rpx;
}

.cp-item .mo {
  font-size: 56rpx;
  line-height: 1;
  flex-shrink: 0;
}

.mi-info {
  flex: 1;
  margin-left: 24rpx;
}

.mi-label {
  font-size: 30rpx;
  font-weight: 600;
}

.mi-time {
  font-size: 22rpx;
  color: var(--label-2);
  margin-top: 6rpx;
}

/* 时段标签（今天/昨天/更早）*/
.day-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--label-2);
  background: rgba(255, 255, 255, 0.35);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.footer-space {
  height: 140rpx;
}

/* ===== 模块标题对齐：与下方 cp-item(32rpx)对齐，覆盖全局 .sec-title(8rpx) ===== */
.sec-title {
  margin: 0 32rpx 16rpx;
}
