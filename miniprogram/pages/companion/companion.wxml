<view class="page-root">
  <!-- 顶部导航胶囊（内联，不用组件——组件编译在本环境不稳定） -->
  <view class="nb-capsule" style="padding-top:{{statusBarHeight}}px;">
    <view class="nb-pill">
      <!-- WebGL 流动烟雾背景 -->
      <canvas type="webgl" id="nb-flux" class="nb-flux"></canvas>
      <view class="nb-title">陪伴</view>
    </view>
  </view>

  <view class="bg-decor"></view>
  <!-- 想你了 圆形渐变按钮 -->
  <view
    class="miss-circle {{pressing ? 'pressed' : ''}}"
    hover-class="miss-hover"
    hover-stay-time="80"
    bindtap="tapMiss"
  >
    <view class="mc-emoji">💗</view>
    <view class="mc-label">想你了</view>
  </view>

  <!-- 早安 / 晚安 半宽按钮 -->
  <view class="companion-row">
    <view class="c-half" hover-class="c-half-pressed" hover-stay-time="80" bindtap="tapMorning">
      <view class="ch-emoji">☀️</view>
      <view class="ch-label">早安</view>
    </view>
    <view class="c-half" hover-class="c-half-pressed" hover-stay-time="80" bindtap="tapNight">
      <view class="ch-emoji">🌙</view>
      <view class="ch-label">晚安</view>
    </view>
  </view>

  <!-- 飘心动画层 -->
  <view class="hearts-layer" wx:if="{{hearts.length}}">
    <view
      wx:for="{{hearts}}"
      wx:key="id"
      class="heart-anim"
      style="left:{{item.left}}rpx;top:{{item.top}}rpx;font-size:{{item.size}}rpx;--dx:{{item.dx}}rpx;--dy:{{item.dy}}rpx;--rot:{{item.rot}}deg;--dur:{{item.dur}}s;"
    >{{item.emoji}}</view>
  </view>

  <!-- 互动记录列表 -->
  <block wx:if="{{list.length}}">
    <view class="sec-title">最近互动</view>
    <view wx:for="{{list}}" wx:key="index" class="cp-item">
      <view class="mo">{{item.emoji}}</view>
      <view class="mi-info">
        <view class="mi-label">{{item.label}}</view>
        <view class="mi-time">{{item.time}}</view>
      </view>
      <view class="day-tag">{{item.dayTag}}</view>
    </view>
  </block>

  <!-- 空状态 -->
  <view wx:else class="empty">
    <view class="e">🫂</view>
    <view class="t">还没点过</view>
    <view>点一下上面的心，告诉 TA 你在想</view>
  </view>

  <view class="footer-space"></view>
</view>
