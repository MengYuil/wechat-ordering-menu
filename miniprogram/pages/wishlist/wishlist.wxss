/* ===== 心愿单页 —— Apple 设计 =====
   通用 card / sec-title / empty 来自 app.wxss */

.page-root {
  min-height: 100vh;
  padding-bottom: 80rpx;
}

/* 顶部大标题 */
.appbar {
  padding: 32rpx 32rpx 20rpx;
}

.headline {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.15;
}

.sub {
  font-size: 26rpx;
  color: var(--label-2);
  margin-top: 8rpx;
}

/* —— 输入区（白卡 + accent 记录按钮）—— */
.wish-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 32rpx 24rpx;
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: saturate(200%) blur(16rpx);
  -webkit-backdrop-filter: saturate(200%) blur(16rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.8),
    inset 0 1rpx 3rpx rgba(255, 255, 255, 0.7),
    0 8rpx 24rpx rgba(0, 0, 0, 0.06),
    0 0 20rpx rgba(10, 132, 255, 0.18);
  border-radius: 999rpx;
  padding: 16rpx 20rpx;
}

.wi-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--label);
}

.wi-ph {
  color: var(--label-3);
}

.wi-btn {
  flex-shrink: 0;
  background: var(--accent);
  color: #FFFFFF;
  border-radius: 999rpx;
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: var(--shadow-btn);
  transition: transform 120ms var(--ease-out);
}
.wi-btn:active {
  transform: scale(0.94);
}

/* —— 心愿条目 —— */
.wish-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 32rpx 20rpx;
}

.wish-main {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.wish-content {
  font-size: 30rpx;
  font-weight: 600;
  word-break: break-all;
}

.wish-content.done {
  color: var(--label-2);
  text-decoration: line-through;
}

.wish-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 22rpx;
  color: var(--label-2);
}

/* 状态徽章：想吃中（橙）/ 已实现（绿）*/
.wish-status {
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  background: var(--orange-soft);
  color: var(--orange);
  font-weight: 600;
}

.wish-status.done {
  background: var(--green-soft);
  color: var(--green);
}

/* 右侧操作区 */
.wish-ops {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.wish-grant {
  background: var(--accent);
  color: #FFFFFF;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
  font-size: 22rpx;
  font-weight: 600;
  transition: transform 120ms var(--ease-out);
}
.wish-grant:active {
  transform: scale(0.92);
}

.wish-del {
  color: var(--label-3);
  font-size: 26rpx;
  padding: 16rpx;
}

/* 加载 / 底部留白 */
.loading {
  text-align: center;
  padding: 60rpx 0;
  color: var(--label-2);
  font-size: 25rpx;
}

.footer-space {
  height: 140rpx;
}
