/* ===== 自定义导航栏 —— 悬浮玻璃胶囊（底部 tabbar 同款）=====
   注意：不能用 position:fixed（本工具环境 fixed 会吞掉下方内容的渲染），用 sticky 吸顶 */
.nb-spacer {
  display: none;  /* sticky 占据正常文档流，无需 spacer */
  width: 100%;
}

.navbar {
  position: sticky;
  top: 0;
}

.nb-inner {
  position: sticky;
  top: 0;
  height: 88rpx;
  margin: 8rpx 24rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 玻璃胶囊：半透明白 + inset 白描边/顶部光 + 蓝光晕（不加 backdrop-filter，避免吞渲染） */
  background: rgba(255, 255, 255, 0.45);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.8),
    inset 0 1rpx 3rpx rgba(255, 255, 255, 0.7),
    0 8rpx 24rpx rgba(0, 0, 0, 0.08),
    0 0 20rpx rgba(10, 132, 255, 0.18);
}

.nb-back {
  position: absolute;
  left: 8rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #0A84FF;
  line-height: 1;
  font-weight: 400;
}

.nb-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--label);
  text-shadow: 0 1rpx 8rpx rgba(255, 255, 255, 0.9);
}
