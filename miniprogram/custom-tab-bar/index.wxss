/* ============================================================
   底部导航 —— Liquid Glass 白色液态玻璃（浅色）
   点击切换：胶囊 CSS transition 滑动 + 选中图标变蓝
   ============================================================ */

/* ===== 容器：悬浮白色液态玻璃胶囊 ===== */
.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  height: 112rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.32); /* 白色液态玻璃 */
  backdrop-filter: blur(16rpx) saturate(200%);
  -webkit-backdrop-filter: blur(16rpx) saturate(200%);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.8),
    inset 0 1rpx 3rpx rgba(255, 255, 255, 0.7),
    0 16rpx 44rpx rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  padding: 0 8rpx;
  z-index: 40;
}

/* 边缘折射高光 */
.tabbar::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: inherit;
  background: linear-gradient(135deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.4) 33%, rgba(255,255,255,0.7) 66%, rgba(255,255,255,0) 100%);
  pointer-events: none;
}

/* ===== 滑动玻璃胶囊 ===== */
.tab-cap {
  position: absolute;
  left: 0;
  top: 50%;              /* translateY(-50%) 垂直居中 */
  height: 90rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.65),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.4),
    0 4rpx 16rpx rgba(0, 0, 0, 0.1),
    0 0 20rpx rgba(10, 132, 255, 0.3);
  /* 滑动动画：果冻吸附（轻微回弹）；拖动中 .dragging 关掉过渡瞬移跟手 */
  transition: transform 0.4s cubic-bezier(0.34, 1.3, 0.64, 1);
  pointer-events: none;
  z-index: 0;
}

/* 拖动中：无过渡，位置瞬移跟手（否则每次 setData 都触发 0.4s 追赶动画 = 乱跳）*/
.tab-cap.dragging {
  transition: none;
}

/* ===== 粉紫自然烟雾（大团絮状云：不规则 blob 变形翻腾 + 呼吸）===== */
.tab-smoke {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: inherit;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}
.smoke {
  position: absolute;
  will-change: transform, border-radius, opacity;
}

/* 粉色云团：左下弥漫，向上翻腾 */
.n1 {
  width: 280rpx; height: 190rpx;
  left: -70rpx; bottom: -46rpx;
  background: radial-gradient(ellipse at 30% 40%, rgba(255, 45, 85, 0.32), rgba(255, 45, 85, 0.1) 45%, transparent 70%);
  filter: blur(26rpx);
  border-radius: 62% 38% 55% 45% / 48% 60% 40% 52%;
  animation: smoke-morph-a 14s ease-in-out infinite;
}

/* 紫色云团：右上弥漫（加大加浓），下沉回旋 */
.n2 {
  width: 320rpx; height: 220rpx;
  right: -70rpx; top: -60rpx;
  background: radial-gradient(ellipse at 60% 40%, rgba(175, 82, 222, 0.42), rgba(175, 82, 222, 0.14) 45%, transparent 70%);
  filter: blur(28rpx);
  border-radius: 40% 60% 45% 55% / 55% 40% 60% 45%;
  animation: smoke-morph-b 16s ease-in-out infinite;
}

/* 中间淡紫雾：贴底成片，缓慢摊开（加浓） */
.n3 {
  width: 340rpx; height: 180rpx;
  left: 20%; bottom: -56rpx;
  background: radial-gradient(ellipse at 50% 50%, rgba(150, 70, 230, 0.24), transparent 65%);
  filter: blur(30rpx);
  border-radius: 55% 45% 60% 40% / 45% 55% 42% 58%;
  animation: smoke-morph-c 18s ease-in-out infinite;
}

/* 三套翻腾路径：形态变形 + 缓慢漂移 + 密度呼吸 */
@keyframes smoke-morph-a {
  0%, 100% {
    transform: translate(0, 0) scale(1);
    border-radius: 62% 38% 55% 45% / 48% 60% 40% 52%;
    opacity: 0.9;
  }
  33% {
    transform: translate(90rpx, -34rpx) scale(1.18);
    border-radius: 45% 55% 62% 38% / 55% 42% 58% 45%;
    opacity: 1;
  }
  66% {
    transform: translate(36rpx, 22rpx) scale(0.9);
    border-radius: 55% 45% 38% 62% / 42% 55% 45% 58%;
    opacity: 0.7;
  }
}
@keyframes smoke-morph-b {
  0%, 100% {
    transform: translate(0, 0) scale(1);
    border-radius: 40% 60% 45% 55% / 55% 40% 60% 45%;
    opacity: 0.85;
  }
  34% {
    transform: translate(-80rpx, 30rpx) scale(1.15);
    border-radius: 55% 45% 40% 60% / 42% 55% 45% 58%;
    opacity: 1;
  }
  67% {
    transform: translate(-30rpx, -24rpx) scale(0.88);
    border-radius: 45% 55% 58% 42% / 58% 42% 55% 45%;
    opacity: 0.65;
  }
}
@keyframes smoke-morph-c {
  0%, 100% {
    transform: translate(0, 0) scale(1);
    border-radius: 55% 45% 60% 40% / 45% 55% 42% 58%;
    opacity: 0.8;
  }
  30% {
    transform: translate(50rpx, -20rpx) scale(1.2);
    border-radius: 42% 58% 50% 50% / 58% 45% 55% 42%;
    opacity: 1;
  }
  65% {
    transform: translate(-40rpx, 18rpx) scale(0.92);
    border-radius: 58% 42% 45% 55% / 42% 58% 45% 55%;
    opacity: 0.6;
  }
}

/* ===== 单个 tab ===== */
.tab {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 88rpx;
  margin: 10rpx 8rpx;
  border-radius: 999rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

/* 图标：SVG 线条（#111111），未选中降透明度 */
.ico {
  width: 44rpx;
  height: 44rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  opacity: 1;  /* 全黑不透明 */
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.lbl {
  font-size: 20rpx;
  font-weight: 600;  /* 加粗 */
  color: #000;
  transition: color 0.2s ease;
}

/* 按压反馈：hover-class 生效时图标放大变蓝（微信官方按压方案，稳定可靠）*/
.tab.pressing .ico {
  transform: translateY(-4rpx) scale(1.18);
  opacity: 1;
  filter: none;
}
.tab.pressing .lbl {
  color: #0A84FF;
  font-weight: 600;
}

/* ===== 选中态：图标上浮变蓝 + 文字变蓝 ===== */
.tab.on .ico {
  transform: translateY(-4rpx) scale(1.1);
  opacity: 1;
}
.tab.on .lbl {
  color: #0A84FF;
  font-weight: 600;
}

